{
  "manifest_version": 3,
  "name": "Tasks→Obsidian 链接助手",
  "version": "1.1.0",
  "description": "在 Google Tasks 页面复制内容时自动检测 Obsidian 链接，弹窗一键打开/复制文件名",
  "permissions": ["clipboardRead", "clipboardWrite", "storage"],
  "host_permissions": [],
  "content_scripts": [
    {
      "matches": ["https://tasks.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
